<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LEO Y APRENDO</title>
<style>
:root{--rosa:#e8438a;--rosa2:#ff7ab2;--fondo:#fff6f9}
*{box-sizing:border-box;font-family:system-ui, sans-serif}
body{margin:0;background:var(--fondo);color:#333;text-align:center}
header{background:linear-gradient(90deg,var(--rosa),var(--rosa2));color:white;padding:18px;font-size:28px;font-weight:800;letter-spacing:1px}
.cont{max-width:800px;margin:0 auto;padding:16px}
.card{background:white;border-radius:18px;padding:22px;box-shadow:0 8px 20px rgba(0,0,0,.08);margin:14px 0}
.btn{background:var(--rosa);color:white;border:0;padding:14px 22px;border-radius:12px;font-size:18px;font-weight:700;cursor:pointer;margin:6px}
.btn:hover{transform:scale(1.03)}
.opciones{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}
.op{padding:18px;border:3px solid #ffe0ec;border-radius:14px;font-size:24px;font-weight:800;cursor:pointer;background:#fff}
.op.correct{background:#c8f7c5;border-color:#2ecc71}
.op.wrong{background:#ffd1d1;border-color:#e74c3c}
h2{margin:6px 0 10px}
.nivel{font-size:14px;background:#ffe0ec;color:var(--rosa);padding:6px 12px;border-radius:20px;display:inline-block;font-weight:700}
.letra{font-size:90px;font-weight:900;color:var(--rosa);margin:10px}
.progreso{height:10px;background:#ffe0ec;border-radius:10px;overflow:hidden}
.progreso i{display:block;height:100%;background:var(--rosa);width:0%}
</style>
</head>
<body>
<header>LEO Y APRENDO ✨</header>
<div class="cont">
<div class="card">
<span class="nivel" id="nivelTxt">NIVEL 1 - VOCALES</span>
<div class="progreso"><i id="barra"></i></div>
<h2 id="pregunta">¿Qué vocal es?</h2>
<div class="letra" id="letra">A</div>
<div class="opciones" id="opciones"></div>
<p id="mensaje"></p>
<button class="btn" onclick="hablar()">🔊 Escuchar</button>
<button class="btn" onclick="siguiente()">Siguiente ➜</button>
</div>
<div class="card">
<p>⭐ Puntos: <b id="puntos">0</b> | Racha: <b id="racha">0</b></p>
<button class="btn" style="background:#333" onclick="reiniciar()">Reiniciar</button>
</div>
</div>
<script>
const niveles=[
{nombre:"VOCALES", datos:["A","E","I","O","U"]},
{nombre:"SÍLABAS", datos:["MA","ME","MI","MO","MU","PA","PE","PI","PO","PU","LA","LE","LI","LO","LU"]},
{nombre:"PALABRAS", datos:["MAMA","PAPA","LUNA","MESA","SOPA","PELOTA","CASA","GATO"]},
{nombre:"ORACIONES", datos:["MI MAMA ME MIMA","LA LUNA SALE","EL GATO DUERME"]}
];
let nivel=0, idx=0, puntos=0, racha=0;
function hablar(){
  const t=document.getElementById("letra").textContent;
  const u=new SpeechSynthesisUtterance(t);
  u.lang="es-ES"; u.rate=0.8;
  speechSynthesis.speak(u);
}
function crearOpciones(){
  const actual=niveles[nivel].datos[idx];
  document.getElementById("letra").textContent=actual;
  document.getElementById("nivelTxt").textContent=`NIVEL ${nivel+1} - ${niveles[nivel].nombre}`;
  document.getElementById("pregunta").textContent=nivel===0?"¿Qué vocal es?":nivel===1?"Lee la sílaba":nivel===2?"Lee la palabra":"Lee la oración";
  let ops=[actual];
  while(ops.length<4){
    let r=niveles[nivel].datos[Math.floor(Math.random()*niveles[nivel].datos.length)];
    if(!ops.includes(r)) ops.push(r);
  }
  ops=ops.sort(()=>Math.random()-0.5);
  const cont=document.getElementById("opciones");
  cont.innerHTML="";
  ops.forEach(o=>{
    const d=document.createElement("div");
    d.className="op"; d.textContent=o;
    d.onclick=()=>comprobar(o,d);
    cont.appendChild(d);
  });
  actualizarBarra();
  setTimeout(hablar,300);
}
function comprobar(sel,div){
  const actual=niveles[nivel].datos[idx];
  if(sel===actual){
    div.classList.add("correct");
    puntos+=10; racha++;
    document.getElementById("mensaje").textContent="¡Muy bien! 🎉";
    document.getElementById("mensaje").style.color="#2ecc71";
    setTimeout(siguiente,800);
  }else{
    div.classList.add("wrong");
    racha=0;
    document.getElementById("mensaje").textContent="Intenta otra vez 💪";
    document.getElementById("mensaje").style.color="#e74c3c";
  }
  document.getElementById("puntos").textContent=puntos;
  document.getElementById("racha").textContent=racha;
}
function siguiente(){
  document.getElementById("mensaje").textContent="";
  idx++;
  if(idx>=niveles[nivel].datos.length){
    idx=0; nivel++;
    if(nivel>=niveles.length){ nivel=0; alert("¡FELICIDADES! Has terminado todos los niveles 🏆"); }
  }
  crearOpciones();
}
function actualizarBarra(){
  const total=niveles[nivel].datos.length;
  const pct=((idx)/total*100);
  document.getElementById("barra").style.width=pct+"%";
}
function reiniciar(){nivel=0;idx=0;puntos=0;racha=0;document.getElementById("puntos").textContent=0;document.getElementById("racha").textContent=0;crearOpciones();}
crearOpciones();
</script>
</body>
</html>
