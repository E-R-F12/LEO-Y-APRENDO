<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LEO Y APRENDO</title>
<style>
:root{--rosa:#e8438a;--rosa2:#ff7ab2;--fondo:#fff6f9;--verde:#2ecc71}
*{box-sizing:border-box;font-family:system-ui, -apple-system, sans-serif}
body{margin:0;background:var(--fondo);color:#333;text-align:center}
header{background:linear-gradient(90deg,var(--rosa),var(--rosa2));color:white;padding:20px;font-size:30px;font-weight:900;letter-spacing:1px}
.cont{max-width:820px;margin:0 auto;padding:16px}
.card{background:white;border-radius:20px;padding:24px;box-shadow:0 10px 25px rgba(0,0,0,.08);margin:16px 0}
.btn{background:var(--rosa);color:white;border:0;padding:14px 22px;border-radius:14px;font-size:18px;font-weight:800;cursor:pointer;margin:6px}
.btn:active{transform:scale(0.97)}
.opciones{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}
.op{padding:20px;border:3px solid #ffe0ec;border-radius:16px;font-size:26px;font-weight:900;cursor:pointer;background:#fff;transition:.2s}
.op.correct{background:#c8f7c5;border-color:var(--verde)}
.op.wrong{background:#ffd1d1;border-color:#e74c3c}
.letra{font-size:95px;font-weight:900;color:var(--rosa);margin:10px 0;min-height:120px}
.nivel{font-size:13px;background:#ffe0ec;color:var(--rosa);padding:6px 14px;border-radius:20px;display:inline-block;font-weight:800;letter-spacing:.5px}
.progreso{height:12px;background:#ffe0ec;border-radius:10px;overflow:hidden;margin:12px 0}
.progreso i{display:block;height:100%;background:var(--rosa);width:0%;transition:.4s}
h2{margin:8px 0 4px;font-size:22px}
#mensaje{min-height:24px;font-weight:700;font-size:18px}
</style>
</head>
<body>
<header>LEO Y APRENDO ✨</header>
<div class="cont">
<div class="card">
<span class="nivel" id="nivelTxt">NIVEL 1</span>
<div class="progreso"><i id="barra"></i></div>
<h2 id="pregunta">¿Qué vocal es?</h2>
<div class="letra" id="letra">A</div>
<div class="opciones" id="opciones"></div>
<p id="mensaje"></p>
<button class="btn" onclick="hablar()">🔊 Escuchar</button>
<button class="btn" style="background:#6c5ce7" onclick="siguiente()">Siguiente ➜</button>
</div>
<div class="card">
<p>⭐ Puntos: <b id="puntos">0</b> | 🔥 Racha: <b id="racha">0</b></p>
<button class="btn" style="background:#333" onclick="reiniciar()">Reiniciar juego</button>
<p style="font-size:13px;color:#999;margin-top:12px">Voz en español activada. Si no escuchas, sube el volumen.</p>
</div>
</div>
<script>
const niveles=[
{nombre:"VOCALES", datos:["A","E","I","O","U"]},
{nombre:"SÍLABAS - MA ME MI MO MU", datos:["MA","ME","MI","MO","MU","PA","PE","PI","PO","PU","LA","LE","LI","LO","LU","SA","SE","SI","SO","SU"]},
{nombre:"PALABRAS", datos:["MAMA","PAPA","LUNA","MESA","SOPA","CASA","GATO","PELOTA","SAPO","LUPA"]},
{nombre:"ORACIONES", datos:["MI MAMA ME MIMA","LA LUNA SALE","EL GATO DUERME","LA SOPA ES RICA","PAPA LEE"]}
];
let nivel=0, idx=0, puntos=0, racha=0;
function hablar(){
  speechSynthesis.cancel();
  const t=document.getElementById("letra").textContent;
  const u=new SpeechSynthesisUtterance(t);
  u.lang="es-ES"; u.rate=0.75;
  speechSynthesis.speak(u);
}
function crearOpciones(){
  const actual=niveles[nivel].datos[idx];
  document.getElementById("letra").textContent=actual;
  document.getElementById("nivelTxt").textContent=`NIVEL ${nivel+1} - ${niveles[nivel].nombre}`;
  document.getElementById("pregunta").textContent=nivel===0?"¿Qué vocal es?":nivel===1?"Lee la sílaba":nivel===2?"Lee la palabra":"Lee la oración";
  let ops=[actual];
  while(ops.length<4){
    let r=niveles[nivel].datos[Math.floor(Math.random()*niveles[nivel].datos.length)];
    if(!ops.includes(r)) ops.push(r);
  }
  ops=ops.sort(()=>Math.random()-0.5);
  const cont=document.getElementById("opciones");
  cont.innerHTML="";
  ops.forEach(o=>{
    const d=document.createElement("div");
    d.className="op"; d.textContent=o;
    d.onclick=()=>comprobar(o,d);
    cont.appendChild(d);
  });
  actualizarBarra();
  setTimeout(hablar,350);
}
function comprobar(sel,div){
  const actual=niveles[nivel].datos[idx];
  if(sel===actual){
    div.classList.add("correct");
    puntos+=10; racha++;
    document.getElementById("mensaje").textContent="¡Muy bien! 🎉";
    document.getElementById("mensaje").style.color="#2ecc71";
    setTimeout(siguiente,900);
  }else{
    div.classList.add("wrong");
    racha=0;
    document.getElementById("mensaje").textContent="Intenta otra vez 💪";
    document.getElementById("mensaje").style.color="#e74c3c";
  }
  document.getElementById("puntos").textContent=puntos;
  document.getElementById("racha").textContent=racha;
}
function siguiente(){
  document.getElementById("mensaje").textContent="";
  idx++;
  if(idx>=niveles[nivel].datos.length){
    idx=0; nivel++;
    if(nivel>=niveles.length){
      alert("¡FELICIDADES! Has terminado todos los niveles 🏆\n¡Eres un campeón lector!");
      nivel=0;
    }
  }
  crearOpciones();
}
function actualizarBarra(){
  const total=niveles[nivel].datos.length;
  const pct=(idx/total*100);
  document.getElementById("barra").style.width=pct+"%";
}
function reiniciar(){nivel=0;idx=0;puntos=0;racha=0;document.getElementById("puntos").textContent=0;document.getElementById("racha").textContent=0;crearOpciones();}
crearOpciones();
</script>
</body>
</html>
